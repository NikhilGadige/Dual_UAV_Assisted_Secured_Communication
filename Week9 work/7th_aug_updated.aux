\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System model of the proposed semantic-aware RIS-assisted UAV ISAC network. The Base Station (BS) communicates with the Target ($T$) and Mobile User ($U$) through an RIS-mounted UAV ($R$) using beamforming and PD-NOMA. A UAV Jammer ($J$) transmits jamming signals while performing monostatic sensing, whereas multiple eavesdroppers ($E_1$, $E_2$, and $E_3$) attempt to intercept the downlink transmissions. Semantic encoders and decoders are employed at the communicating nodes.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:system_model}{{1}{2}{System model of the proposed semantic-aware RIS-assisted UAV ISAC network. The Base Station (BS) communicates with the Target ($T$) and Mobile User ($U$) through an RIS-mounted UAV ($R$) using beamforming and PD-NOMA. A UAV Jammer ($J$) transmits jamming signals while performing monostatic sensing, whereas multiple eavesdroppers ($E_1$, $E_2$, and $E_3$) attempt to intercept the downlink transmissions. Semantic encoders and decoders are employed at the communicating nodes}{figure.1}{}}
